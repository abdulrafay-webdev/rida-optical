# ==============================================================================
# RIDA OPTICAL FASTAPI BACKEND — ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env and configure for your local or production environment.
# DO NOT commit actual secrets or production database passwords to version control.

PROJECT_NAME="Rida Optical API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://ridaoptical.com"

# Security & JWT Token Authentication
SECRET_KEY="replace-with-a-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Neon Serverless PostgreSQL Connection String (To be configured in Phase 10)
# Format: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
DATABASE_URL=

# ImageKit Media CDN Endpoint
IMAGEKIT_ENDPOINT="https://ik.imagekit.io/ridaoptical"

# Business & Shipping Defaults (Nationwide Flat Rate Delivery)
STORE_PHONE="+923212318001"
STORE_PHONE_DISPLAY="+92 321 2318001"
STORE_EMAIL="ridaoptical@gmail.com"
FLAT_SHIPPING_FEE_PKR=349.0
